<Window x:Class="IntegDataEvent_Midterms.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IntegDataEvent_Midterms"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Border CornerRadius="10">
            <Border.Background>
                <ImageBrush ImageSource="C:\Users\andre\Pictures\mort.jpg" />
            </Border.Background>


            <Border CornerRadius="10"
            BorderThickness="3"
            Opacity="0.95">

                <Grid>
                    <Border Background="White" Margin="-19,-27,-19,-27"/>
                    <Border BorderBrush="Black" Margin="244,51,244,51" BorderThickness="1" CornerRadius="10" Background="White">
                        <StackPanel>
                            <TextBlock Text="Login" FontSize="40" TextAlignment="Center"/>
                            <TextBlock Text="Email" FontSize="20" Margin="0,20,0,0" Width="295" />
                            <TextBox FontSize="20" Width="295" Text="{Binding currentUser.Username, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Password" FontSize="20" Margin="0,20,0,0" Width="295"/>
                            <TextBox FontSize="20" Width="295" Text="{Binding currentUser.Password, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Login" FontSize="20" Margin="0,20,0,0" Width="82" Height="37" Command="{Binding logincommand}"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
